{
  "$schema": "https://raw.githubusercontent.com/Containerpak/cpak/v2/schema/manifest-v3.json",
  "manifest_version": "3.0",
  "name": "Vulkan and Shader SDK",
  "description": "Vulkan headers, diagnostics, glslang and SPIR-V development tools.",
  "version": "1.4.341",
  "image": "ghcr.io/containerpak/sdk-vulkan@sha256:364c4b901bcf2d9caba9fb3b41a9b9315a75821e1328bbe25c6c04710c6ec02d",
  "binaries": [
    "/usr/bin/glslang",
    "/usr/bin/glslangValidator",
    "/usr/bin/spirv-as",
    "/usr/bin/spirv-dis",
    "/usr/bin/spirv-link",
    "/usr/bin/spirv-opt",
    "/usr/bin/spirv-val",
    "/usr/bin/vkcube",
    "/usr/bin/vkcubepp",
    "/usr/bin/vulkaninfo"
  ],
  "desktop_entries": [],
  "dependencies": [],
  "addons": [],
  "addon_provider": {
    "id": "vulkan",
    "slot": "sdk.vulkan",
    "mode": "exclusive",
    "exports": {
      "path": [
        "/usr/bin"
      ]
    }
  },
  "idle_time": 0,
  "override": {
    "displayX11": false,
    "socketWayland": true,
    "socketPulseAudio": false,
    "socketSshAgent": true,
    "socketCups": false,
    "socketGpgAgent": true,
    "bluetooth": false,
    "deviceDri": true,
    "deviceKvm": false,
    "deviceShm": false,
    "deviceAlsa": false,
    "deviceVideo": false,
    "deviceFuse": false,
    "deviceTun": false,
    "deviceUsb": false,
    "deviceSerial": false,
    "deviceInput": false,
    "deviceTTY": false,
    "deviceAll": false,
    "notification": false,
    "openURI": false,
    "hostApplications": false,
    "filesystem": [
      {
        "path": "home",
        "access": "read-write"
      }
    ],
    "env": [],
    "network": true,
    "hostNetwork": true,
    "process": false,
    "userNamespaces": false,
    "memoryMaxMB": 0,
    "cpuQuota": 0,
    "pidsMax": 0,
    "asRoot": false
  }
}
